{
    "name": "restaurant-management-backend",
    "version": "1.0.0",
    "description": "A complete backend REST API server for restaurant management with Node.js, Express, MongoDB, and TypeScript",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "start:prod": "dotenv -e .prod.env -- node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "build:prod": "dotenv -e .prod.env -- tsc",
        "build:watch": "tsc --watch",
        "clean": "rimraf dist",
        "prebuild": "npm run clean",
        "check-env": "node scripts/check-env.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "format": "prettier --write src/**/*.ts",
        "create-admin-users": "node scripts/create-admin-users.js",
        "docker:build": "docker build -t restaurant-management-api .",
        "docker:run": "docker run -p 3000:3000 restaurant-management-api",
        "docker:compose": "docker-compose up --build",
        "docker:compose:down": "docker-compose down",
        "type-check": "tsc --noEmit"
    },
    "keywords": [
        "restaurant",
        "management",
        "api",
        "nodejs",
        "express",
        "mongodb",
        "typescript",
        "jwt",
        "oauth",
        "rbac"
    ],
    "author": "Restaurant Management Team",
    "license": "MIT",
    "dependencies": {
        "@types/supertest": "^6.0.3",
        "bcryptjs": "^2.4.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^6.10.0",
        "express-validator": "^7.0.1",
        "firebase-admin": "^13.4.0",
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^6.17.0",
        "mongoose": "^7.5.0",
        "multer": "^1.4.5-lts.2",
        "nodemailer": "^6.9.4",
        "passport": "^0.6.0",
        "passport-facebook": "^3.0.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.1.13",
        "stripe": "^13.5.0",
        "supertest": "^7.1.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "twilio": "^4.12.0",
        "typeorm": "^0.3.17",
        "winston": "^3.10.0",
        "yup": "^1.3.2"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.2",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.4",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/mongodb-memory-server": "^2.3.0",
        "@types/multer": "^1.4.7",
        "@types/node": "^20.5.0",
        "@types/nodemailer": "^6.4.9",
        "@types/passport": "^1.0.12",
        "@types/passport-facebook": "^2.1.11",
        "@types/passport-google-oauth20": "^2.0.11",
        "@types/passport-jwt": "^3.0.9",
        "@types/swagger-jsdoc": "^6.0.1",
        "@types/swagger-ui-express": "^4.1.3",
        "@types/twilio": "^3.19.3",
        "@typescript-eslint/eslint-plugin": "^6.4.1",
        "@typescript-eslint/parser": "^6.4.1",
        "dotenv-cli": "^8.0.0",
        "eslint": "^8.47.0",
        "jest": "^29.6.2",
        "mongo-mock": "^4.2.0",
        "mongodb-memory-server": "^10.1.4",
        "prettier": "^3.0.2",
        "rimraf": "^5.0.1",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.6"
    },
    "engines": {
        "node": ">=16.0.0",
        "npm": ">=8.0.0"
    }
}
